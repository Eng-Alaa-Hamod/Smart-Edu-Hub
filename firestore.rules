rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasExactKeys(fields) {
      return request.resource.data.keys().hasAll(fields)
        && request.resource.data.keys().hasOnly(fields);
    }

    function changedKeysOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasUserProfile(userId) {
      return exists(userPath(userId));
    }

    function activeUser() {
      return signedIn()
        && request.auth.token.email_verified == true
        && hasUserProfile(request.auth.uid)
        && get(userPath(request.auth.uid)).data.isDisable != true;
    }

    function hasRole(userId, role) {
      return hasUserProfile(userId)
        && get(userPath(userId)).data.role == role
        && get(userPath(userId)).data.isDisable != true;
    }

    function isAdmin() {
      return activeUser() && get(userPath(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return activeUser() && get(userPath(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent() {
      return activeUser() && get(userPath(request.auth.uid)).data.role == 'student';
    }

    function coursePath(courseId) {
      return /databases/$(database)/documents/courses/$(courseId);
    }

    function isCourseTeacher(courseId) {
      return isTeacher()
        && exists(coursePath(courseId))
        && get(coursePath(courseId)).data.teacherId == request.auth.uid;
    }

    function isCourseParticipant(courseId) {
      return isAdmin() || isCourseTeacher(courseId);
    }

    function canSendMessage() {
      return activeUser()
        && get(userPath(request.auth.uid)).data.canSend != false;
    }

    function canReadUser(userId) {
      return activeUser()
        && (userId == request.auth.uid
          || isAdmin()
          || resource.data.role == 'admin'
          || (isStudent() && resource.data.role == 'teacher')
          || (isTeacher() && resource.data.role == 'student'));
    }

    function validUserCreate(userId) {
      return signedIn()
        && userId == request.auth.uid
        && hasExactKeys([
          'uid', 'firstName', 'secondName', 'email', 'role', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.firstName is string
        && request.resource.data.secondName is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.createdAt is timestamp;
    }

    function validOwnProfileUpdate(userId) {
      return activeUser()
        && userId == request.auth.uid
        && changedKeysOnly([
          'firstName', 'secondName', 'CV', 'photoURL'
        ])
        && (!('firstName' in request.resource.data)
          || request.resource.data.firstName is string)
        && (!('secondName' in request.resource.data)
          || request.resource.data.secondName is string)
        && (!('CV' in request.resource.data)
          || request.resource.data.CV is string)
        && (!('photoURL' in request.resource.data)
          || request.resource.data.photoURL is string);
    }

    function validAdminUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && ((changed.hasOnly(['role'])
            && request.resource.data.role in ['student', 'teacher', 'admin'])
          || (changed.hasOnly(['canSend'])
            && request.resource.data.canSend is bool)
          || (changed.hasOnly(['isDisable'])
            && request.resource.data.isDisable is bool)
          || (changed.hasOnly(['countReports'])
            && request.resource.data.countReports is int
            && request.resource.data.countReports >= 0));
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function validBookingNotification(targetUserId) {
      let bookingId = request.resource.data.relatedId;
      return request.resource.data.type == 'booking'
        && bookingId is string
        && exists(bookingPath(bookingId))
        && ((get(bookingPath(bookingId)).data.studentId == request.auth.uid
            && get(bookingPath(bookingId)).data.teacherUID == targetUserId)
          || (get(bookingPath(bookingId)).data.teacherUID == request.auth.uid
            && get(bookingPath(bookingId)).data.studentId == targetUserId));
    }

    function validRegistrationNotification(targetUserId) {
      return request.resource.data.type == 'user_registration'
        && request.resource.data.relatedId == request.auth.uid
        && (isStudent() || isTeacher())
        && hasRole(targetUserId, 'admin');
    }

    function validNotification(targetUserId) {
      return hasExactKeys([
          'title', 'message', 'type', 'relatedId', 'targetPath', 'read', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.type in [
          'booking', 'game', 'user_registration', 'general'
        ]
        && (request.resource.data.relatedId == null
          || request.resource.data.relatedId is string)
        && request.resource.data.targetPath is string
        && request.resource.data.targetPath.matches('^/[A-Za-z0-9/_-]*$')
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && (isAdmin()
          || targetUserId == request.auth.uid
          || validBookingNotification(targetUserId)
          || validRegistrationNotification(targetUserId));
    }

    match /users/{userId} {
      allow get, list: if canReadUser(userId);
      allow create: if validUserCreate(userId);
      allow update: if validOwnProfileUpdate(userId) || validAdminUserUpdate();
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow get, list: if activeUser() && request.auth.uid == userId;
        allow create: if activeUser() && validNotification(userId);
        allow update: if activeUser()
          && request.auth.uid == userId
          && changedKeysOnly([
            'read', 'readAt'
          ])
          && request.resource.data.read == true
          && request.resource.data.readAt is timestamp;
        allow delete: if activeUser() && request.auth.uid == userId;
      }
    }

    match /courses/{courseId} {
      allow get, list: if activeUser();
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && hasExactKeys([
          'teacherId', 'teacherName', 'teacherPhotoURL', 'title',
          'description', 'coverUrl', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin()
        || (isCourseTeacher(courseId)
          && changedKeysOnly([
            'teacherName', 'teacherPhotoURL', 'title', 'description', 'coverUrl'
          ]));
      allow delete: if isAdmin() || isCourseTeacher(courseId);

      match /lessons/{lessonId} {
        allow get, list: if activeUser();
        allow create: if isCourseParticipant(courseId)
          && hasExactKeys([
            'title', 'description', 'pdfUrl', 'order', 'createdAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.description is string
          && request.resource.data.pdfUrl is string
          && request.resource.data.order is number
          && request.resource.data.createdAt is timestamp;
        allow update: if isAdmin() || isCourseTeacher(courseId);
        allow delete: if isAdmin() || isCourseTeacher(courseId);
      }
    }

    match /enrollments/{enrollmentId} {
      allow get, list: if activeUser()
        && (isAdmin()
          || resource.data.studentId == request.auth.uid
          || isCourseTeacher(resource.data.courseId));
      allow create: if isStudent()
        && hasExactKeys(['studentId', 'courseId', 'enrolledAt'])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.courseId is string
        && exists(coursePath(request.resource.data.courseId))
        && request.resource.data.enrolledAt is timestamp;
      allow update: if false;
      allow delete: if isAdmin() || (isStudent()
        && resource.data.studentId == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow get, list: if activeUser()
        && (isAdmin()
          || resource.data.studentId == request.auth.uid
          || resource.data.teacherUID == request.auth.uid);
      allow create: if isStudent()
        && hasExactKeys([
          'teacherUID', 'teacherName', 'teacherEmail', 'teacherPhotoURL',
          'studentId', 'studentName', 'studentEmail', 'date', 'startTime',
          'endTime', 'status', 'createdAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && hasRole(request.resource.data.teacherUID, 'teacher')
        && request.resource.data.date is timestamp
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin()
        || (isTeacher()
          && resource.data.teacherUID == request.auth.uid
          && changedKeysOnly(['status'])
          && request.resource.data.status in ['accepted', 'rejected']);
      allow delete: if isAdmin()
        || (activeUser()
          && (resource.data.studentId == request.auth.uid
            || resource.data.teacherUID == request.auth.uid));
    }

    match /library/{pdfId} {
      allow get, list: if activeUser();
      allow create: if isStudent()
        && hasExactKeys([
          'title', 'description', 'pdfUrl', 'imageUrl', 'userId', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.pdfUrl is string
        && request.resource.data.imageUrl is string
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (activeUser() && resource.data.userId == request.auth.uid);
    }

    match /courseCount/{teacherId} {
      allow get, list: if isAdmin()
        || (activeUser() && request.auth.uid == teacherId);
      allow create, update: if isAdmin()
        || (isTeacher()
          && request.auth.uid == teacherId
          && request.resource.data.teacherID == request.auth.uid
          && request.resource.data.count is number
          && request.resource.data.teacherName is string
          && request.resource.data.keys().hasOnly(['count', 'teacherName', 'teacherID']));
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow get: if activeUser();
      allow list: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['inputDisabled'])
        && request.resource.data.inputDisabled is bool
        && (isAdmin()
          || (chatId == 'global' && isTeacher())
          || (chatId.matches('^course_[A-Za-z0-9]+$')
            && isCourseTeacher(chatId.split('_')[1])));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function canAccessMessages() {
          return activeUser()
            && (chatId == 'global'
              || isAdmin()
              || (chatId.matches('^course_[A-Za-z0-9]+$')
                && isCourseTeacher(chatId.split('_')[1])));
        }

        allow get, list: if canAccessMessages();
        allow create: if canAccessMessages()
          && canSendMessage()
          && hasExactKeys([
            'text', 'senderId', 'senderName', 'senderAvatarUrl', 'timestamp'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.senderName is string
          && request.resource.data.timestamp is timestamp;
        allow update: if false;
        allow delete: if activeUser()
          && (isAdmin() || resource.data.senderId == request.auth.uid);
      }
    }

    match /playerAchievements/{userId} {
      allow get: if activeUser() && (isAdmin() || request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /Game/{teacherId}/Quizzes/{quizId} {
      allow get, list: if isAdmin() || (isTeacher() && request.auth.uid == teacherId);
      allow create, update: if isAdmin()
        || (isTeacher()
          && request.auth.uid == teacherId
          && request.resource.data.keys().hasOnly(['name'])
          && request.resource.data.name is string);
      allow delete: if isAdmin() || (isTeacher() && request.auth.uid == teacherId);

      match /Questions/{questionId} {
        allow get, list: if isAdmin() || (isTeacher() && request.auth.uid == teacherId);
        allow create: if isAdmin()
          || (isTeacher()
            && request.auth.uid == teacherId
            && hasExactKeys([
              'question', 'options', 'correctAnswer', 'timeLimit', 'createdAt'
            ])
            && request.resource.data.question is string
            && request.resource.data.options is list
            && request.resource.data.correctAnswer is number
            && request.resource.data.timeLimit is number
            && request.resource.data.createdAt is int);
        allow update: if false;
        allow delete: if isAdmin() || (isTeacher() && request.auth.uid == teacherId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}